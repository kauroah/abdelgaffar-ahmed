# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="YOUR_APP_URL"

# FISH_API_KEY: Optional Fish Audio API key for custom VOID voice reference synthesis.
FISH_API_KEY="MY_FISH_API_KEY"

# Resend Contact Form Configuration
RESEND_API_KEY="YOUR_RESEND_API_KEY"
# Test only. For production, use an address on a verified Resend domain.
RESEND_FROM="Ahmed Abdelgaffar <onboarding@resend.dev>"
CONTACT_EMAIL_TO="ahmedabdelhady0246@gmail.com"
